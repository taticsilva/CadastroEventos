<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CadastroEventos.ResumoPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Resumo do Evento"
    BackgroundColor="#F8F5FC">

    <ScrollView>
        <VerticalStackLayout Padding="25" Spacing="15">

            <Label Text="Cadastro concluído!"
                   FontSize="26"
                   FontAttributes="Bold"
                   TextColor="#6A3FA0"
                   HorizontalOptions="Center"/>

            <Label Text="Resumo das informações"
                   HorizontalOptions="Center"
                   TextColor="#665D70"/>

            <Border BackgroundColor="White"
                    Stroke="#E2D7EF"
                    StrokeThickness="1"
                    Padding="20">

                <VerticalStackLayout Spacing="12">

                    <Label Text="Nome do evento"
                           FontAttributes="Bold"
                           TextColor="#8062A5"/>

                    <Label Text="{Binding Nome}"
                           FontSize="18"
                           TextColor="#292333"/>

                    <BoxView HeightRequest="1"
                             Color="#EAE3F1"/>

                    <Label Text="Data de início"
                           FontAttributes="Bold"/>

                    <Label Text="{Binding DataInicio, StringFormat='{0:dd/MM/yyyy}'}"/>

                    <Label Text="Data de término"
                           FontAttributes="Bold"/>

                    <Label Text="{Binding DataTermino, StringFormat='{0:dd/MM/yyyy}'}"/>

                    <Label Text="Duração do evento"
                           FontAttributes="Bold"/>

                    <Label Text="{Binding DuracaoFormatada}"/>

                    <Label Text="Participantes"
                           FontAttributes="Bold"/>

                    <Label Text="{Binding NumeroParticipantes, StringFormat='{0:N0}'}"/>

                    <Label Text="Local"
                           FontAttributes="Bold"/>

                    <Label Text="{Binding Local}"/>

                    <Label Text="Custo por participante"
                           FontAttributes="Bold"/>

                    <Label x:Name="ValorIndividual"/>

                    <BoxView HeightRequest="1"
                             Color="#EAE3F1"/>

                    <Label Text="CUSTO TOTAL DO EVENTO"
                           FontAttributes="Bold"
                           TextColor="#8062A5"/>

                    <Label x:Name="ValorTotal"
                           FontSize="26"
                           FontAttributes="Bold"
                           TextColor="#6A3FA0"/>

                </VerticalStackLayout>
            </Border>

            <Button Text="Voltar ao cadastro"
                    Clicked="OnVoltarCadastro"
                    BackgroundColor="#6A3FA0"
                    TextColor="White"
                    CornerRadius="12"
                    HeightRequest="50"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
